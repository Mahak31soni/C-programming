//A number is an Armstrong number if the sum of each digit raised to the power of the number of digits equals the original number.

#include <bits/stdc++.h>
using namespace std;

//armstring number - 1^3+5^3+3^3 = 1+125+27 = 153
int power(int base, int exponent)
{
    int res = 1;
    while(exponent--)
    {
        res *= base;
    }
    return res;
}
int main()
{
    int n= 153;
    int num =153;
    int digit = 0;
    int result = 0;
    
    while(n!= 0)
    {   
        n = n/10;
        digit ++;
    }
    cout << digit<<endl;
    
    
    while(num!=0)
    {
        int rem = num%10;
        cout<<rem<<endl;
        result = result + power(rem, digit);
        cout << result<<endl;
        num = num/10;
    }
    
    cout << result;
}
