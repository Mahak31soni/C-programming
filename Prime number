#include <iostream>
using namespace std;

int main()
{
    bool prime = true;
    int num  = 17;
    
    if( num<= 1)
    {
        prime = false;
    }
    for(int i = 2; i*i<= num; i++)
    {
        if(num % i == 0)
        {
            prime = false;
            break;
        }
    }
    if(prime == true)
    {
        cout << "Yes";
    }
    else
    {
        cout << "No";
    }
}
